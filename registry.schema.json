{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungle-scrubs.github.io/model-registry/registry.schema.json",
  "title": "Model registry, format 1",
  "description": "The format 1 slice supported by this release of model-registry: format, ratings, capabilities, meters, models, calibration and the router's foreign sections.",
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "ratings": {
      "$ref": "#/$defs/ratings"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "meters": {
      "$ref": "#/$defs/meters"
    },
    "models": {
      "$ref": "#/$defs/models"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    }
  },
  "required": ["format", "models"],
  "additionalProperties": {
    "$ref": "#/$defs/jsonValue"
  },
  "$defs": {
    "jsonValue": {
      "description": "Any non-null JSON value; null is not valid anywhere in a registry file.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "ratings": {
      "description": "Maps each rating name to a description string; one line is the convention, not a rule. Every rating a model uses must be declared here, except the reserved route-level rating cost.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capabilities": {
      "description": "Maps each capability name to a one-sentence description string. Every capability a route lists must be declared here.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "meters": {
      "description": "Maps each meter name to its declaration. The closed shape accepts an optional notes string and an optional spendToZero flag, which is only meaningful when true and accepts exactly the literal true.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/meter"
      }
    },
    "meter": {
      "type": "object",
      "properties": {
        "spendToZero": {
          "const": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "effortLevel": {
      "description": "An effort ladder level, in order low < medium < high < xhigh < max. The values mirror the exported EFFORT_LADDER; the two stay equal in order.",
      "enum": ["low", "medium", "high", "xhigh", "max"]
    },
    "models": {
      "description": "Models and their routes, keyed by model key.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "ratings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ratingValue"
          }
        },
        "maxEffort": {
          "$ref": "#/$defs/effortLevel"
        },
        "fixedEffort": {
          "$ref": "#/$defs/effortLevel"
        }
      },
      "required": ["family", "routes"],
      "additionalProperties": false
    },
    "ratingValue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "route": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "hosted": {
          "type": "boolean"
        },
        "privacyEligible": {
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/ratingValue"
        },
        "rateLimitRpm": {
          "type": "number",
          "minimum": 0
        },
        "responseSeconds": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meter": {
          "type": "string"
        }
      },
      "required": ["harness", "modelId", "hosted"],
      "additionalProperties": false
    },
    "calibration": {
      "description": "How the registry's ratings were produced. Notes are free text on the section and on each benchmark; every other field is closed.",
      "type": "object",
      "properties": {
        "notes": {
          "type": "string"
        },
        "benchmarks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/benchmark"
          }
        },
        "feeds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "handSet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "figures": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/figure"
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/override"
          }
        }
      },
      "additionalProperties": false
    },
    "benchmark": {
      "description": "One benchmark and its banded scoring. direction higher means at or above at; lower means at or below. The first band that matches wins.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "direction": {
          "enum": ["higher", "lower"]
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/band"
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["source", "field", "version", "direction", "bands"],
      "additionalProperties": false
    },
    "band": {
      "description": "One band on a benchmark: a figure value at or above (higher) or at or below (lower) at scores score.",
      "type": "object",
      "properties": {
        "at": {
          "type": "number"
        },
        "score": {
          "$ref": "#/$defs/ratingValue"
        }
      },
      "required": ["at", "score"],
      "additionalProperties": false
    },
    "figure": {
      "description": "One figure read for one model or route on one benchmark.",
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "read": {
          "type": "string"
        },
        "effort": {
          "$ref": "#/$defs/effortLevel"
        }
      },
      "required": ["value", "read", "effort"],
      "additionalProperties": false
    },
    "override": {
      "description": "One override that lets a written rating disagree with the table. Exactly one of model or route is required.",
      "type": "object",
      "properties": {
        "rating": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ratingValue"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["rating", "value", "reason"],
      "additionalProperties": false,
      "dependentSchemas": {
        "model": {
          "not": {
            "required": ["route"]
          }
        },
        "route": {
          "not": {
            "required": ["model"]
          }
        }
      },
      "anyOf": [
        {
          "required": ["model"]
        },
        {
          "required": ["route"]
        }
      ]
    }
  }
}
